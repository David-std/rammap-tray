<Window x:Class="RAMMapTray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memoria" Width="332" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated"
        MouseMove="Window_UserInteraction" PreviewMouseDown="Window_UserInteraction" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Windows 11 Dark Surface Palette (sampled from Settings & Task Manager) -->
        <Color x:Key="SurfaceColor">#242424</Color>
        <Color x:Key="CardColor">#2C2C2C</Color>
        <Color x:Key="StrokeColor">#1F1F1F</Color>
        <Color x:Key="DividerColor">#363636</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
        <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

        <!-- Windows 11 Text Ramp -->
        <SolidColorBrush x:Key="TextPrimary" Color="#EBEBEB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#ABABAB" />
        <SolidColorBrush x:Key="TextTertiary" Color="#6B6B6B" />

        <!-- System Accent (Windows 11 Default Blue) -->
        <SolidColorBrush x:Key="AccentDefault" Color="#76B9ED" />
        <SolidColorBrush x:Key="ProgressTrack" Color="#353535" />
        <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#333333" />

        <!-- WinUI 3 Card Button (optical balance to match the visual lightness of the Metric Card) -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3E3E3E" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#262626" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A" />
                                <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WinUI 3 Accent Button (AccentFillColorDefault) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#76B9ED" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#8DC7F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5FA8D8" />
                                <Setter Property="Foreground" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#353535" />
                                <Setter Property="Foreground" Value="#6B6B6B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Icon Button -->
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Window Chrome -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000000" Direction="270" Opacity="0.5" ShadowDepth="3"/>
        </Border.Effect>

        <StackPanel Margin="0">
            <!-- Title Bar -->
            <Grid Margin="16,12,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentDefault}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Memoria" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource CaptionCloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <!-- Metric Card -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Margin="16,12,16,0" Padding="16,14">
                <StackPanel>
                    <!-- Hero Numbers -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPercentage" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtUsedOfTotal" Text="0.0 / 0.0 GB" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </Grid>

                    <!-- Progress Bar -->
                    <Border Background="{StaticResource ProgressTrack}" CornerRadius="2" Height="4" Margin="0,0,0,14">
                        <Border x:Name="ProgressFill" Background="{StaticResource AccentDefault}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Border>

                    <!-- Breakdown -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="En uso" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                            <TextBlock x:Name="TxtRamUsed" Text="—" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Standby" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                            <TextBlock x:Name="TxtRamStandby" Text="—" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Libre" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                            <TextBlock x:Name="TxtRamFree" Text="—" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Rectangle Fill="{StaticResource DividerBrush}" Height="1" Margin="16,12,16,0"/>

            <!-- Action Row: Inline with description -->
            <Grid Margin="16,10,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Liberar memoria del sistema" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnOptimize" Content="Optimizar" Width="114" Height="26" Padding="0" HorizontalContentAlignment="Center" Style="{StaticResource AccentButton}" Click="PurgeAll_Click"/>
            </Grid>

            <!-- Secondary Action Links -->
            <UniformGrid Columns="3" Margin="16,10,16,14">
                <Button x:Name="BtnWorkingSets" Content="Working Sets" Height="26" Style="{StaticResource SubtleButton}" Click="PurgeWorkingSets_Click" Margin="0,0,3,0"/>
                <Button x:Name="BtnStandby" Content="Standby List" Height="26" Style="{StaticResource SubtleButton}" Click="PurgeStandby_Click" Margin="3,0,3,0"/>
                <Button x:Name="BtnRAMMap" Content="RAMMap" Height="26" Style="{StaticResource SubtleButton}" Click="OpenRAMMap_Click" Margin="3,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
